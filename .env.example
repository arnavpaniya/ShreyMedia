# ==============================================================================
# SHREY MEDIA & TECHNOLOGY SOLUTIONS - ENVIRONMENT VARIABLES
# ==============================================================================
# Create a .env.local file in the project root and add your actual Supabase keys.
# ==============================================================================

# 1. Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Publishable Public API Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
# (Alternatively, you can also use NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
