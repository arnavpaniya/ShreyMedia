# ==============================================================================
# SHREY MEDIA & TECHNOLOGY SOLUTIONS - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' in the project root:
#    cp .env.example .env.local
# 2. Fill in your actual production values.
# 3. Note: Variables prefixed with 'NEXT_PUBLIC_' are exposed to client browsers.
#    Variables WITHOUT 'NEXT_PUBLIC_' are STRICT SERVER SECRETS and are never leaked.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 PUBLIC ENVIRONMENT VARIABLES (Exposed to browser for Supabase RLS)
# ------------------------------------------------------------------------------
# Supabase Project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Public Key (Safe for public reads via RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 🔒 PRIVATE SERVER-SIDE SECRETS (STRICTLY ISOLATED FROM CLIENT INSPECTION)
# ------------------------------------------------------------------------------
# Master Admin PIN for Shrey Media Studio Portal (default: 9001)
ADMIN_PIN=9001
ADMIN_BACKUP_PIN=admin2026

# Cryptographic Secret used to sign admin session tokens on the server
ADMIN_SECRET=generate-a-secure-random-string-here-2026

# Optional: Supabase Service Role Key (NEVER use NEXT_PUBLIC_ prefix for this!)
# Used only in Server Actions for elevated database administration if needed
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
